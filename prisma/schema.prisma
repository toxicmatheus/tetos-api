generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model historico_imovel {
  id               String     @id @db.Uuid
  descricao        String
  data_entrada     DateTime   @db.Date
  data_saida       DateTime   @db.Date
  valor_aluguel    Float      @default(0)
  valor_iptu       Float      @default(0)
  imovel_id        String     @db.Uuid
  locatario_id     String     @db.Uuid
  valor_condominio Float      @default(0)
  createdAt        DateTime   @default(now()) @db.Timestamp(6)
  updatedAt        DateTime?  @default(now()) @db.Timestamp(6)
  imoveis          imoveis    @relation(fields: [imovel_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "historico_imovel_imovel_fk")
  locatarios       locatarios @relation(fields: [locatario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "historico_imovel_locatario_fk")
}

model historico_manutecao {
  id        String    @id @db.Uuid
  descricao String
  valor     Float
  data      DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  imovel_id String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  imoveis   imoveis   @relation(fields: [imovel_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "historico_manutecao_imovel_fk")
}

model imoveis {
  id                  String                @id @db.Uuid
  matricula           Int?
  logrador            String                @db.VarChar(50)
  bairro              String                @db.VarChar(50)
  cidade              String                @db.VarChar(50)
  estado              String                @db.VarChar(2)
  numero              String                @db.VarChar(15)
  complemento         String?               @db.VarChar(15)
  cep                 String                @db.VarChar(10)
  valor_aluguel       Float
  iptu                Float?
  valor_condominio    Float?
  metragem            Float
  quartos             Int                   @default(0)
  suites              Int                   @default(0)
  banheiros           Int
  garagens            Int?
  tipo_id             String                @db.Uuid
  locatario_id        String?               @db.Uuid
  createdAt           DateTime              @default(now()) @db.Timestamp(6)
  updatedAt           DateTime?             @default(now()) @db.Timestamp(6)
  historico_imovel    historico_imovel[]
  historico_manutecao historico_manutecao[]
  locatarios          locatarios?           @relation(fields: [locatario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "imoveis_locatario_fk")
  imoveis_tipo        imoveis_tipo          @relation(fields: [tipo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "imoveis_tipo_fk")
}

model imoveis_tipo {
  id        String    @id @db.Uuid
  nome      String    @db.VarChar(50)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  imoveis   imoveis[]
}

model locatarios {
  id               String             @id @db.Uuid
  nome             String             @db.VarChar(50)
  telefone         String             @db.VarChar(50)
  cpf_cnpj         String             @unique @db.VarChar(20)
  createdAt        DateTime           @default(now()) @db.Timestamp(6)
  updatedAt        DateTime?          @default(now()) @db.Timestamp(6)
  historico_imovel historico_imovel[]
  imoveis          imoveis[]
}

model niveis {
  id        String     @id @db.Uuid
  nome      String     @db.VarChar(50)
  createdAt DateTime   @default(now()) @db.Timestamp(6)
  updatedAt DateTime?  @default(now()) @db.Timestamp(6)
  usuarios  usuarios[]
}

model usuarios {
  id        String    @id @db.Uuid
  nome      String    @db.VarChar(50)
  email     String    @unique @db.VarChar(50)
  senha     String    @db.VarChar(255)
  n_veis_id String    @map("níveis_id") @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  niveis    niveis    @relation(fields: [n_veis_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "usuarios_niveis_fk")
}
